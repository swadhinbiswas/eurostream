# EuroStream configuration — copy to .env and adjust.
# Every variable is prefixed with EUROSTREAM_ (pydantic-settings).

# --- Event bus -----------------------------------------------------------
# sqlite = local durable log (zero deps) | kafka = confluent-kafka adapter (Aiven)
EUROSTREAM_EVENT_BUS_BACKEND=sqlite
# For Aiven free Kafka: split Service URI https://user:pass@host:port into these:
EUROSTREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUROSTREAM_KAFKA_USERNAME=
EUROSTREAM_KAFKA_PASSWORD=
EUROSTREAM_KAFKA_SECURITY_PROTOCOL=SASL_SSL
EUROSTREAM_KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# --- Storage paths -------------------------------------------------------
EUROSTREAM_DATA_DIR=./data
EUROSTREAM_WAREHOUSE_PATH=./data/eurocart.duckdb
EUROSTREAM_LAKE_ROOT=./data/lake

# --- Governance ----------------------------------------------------------
# Salt for PII hashing. In production load this from a secret manager,
# never commit it. Changing the salt invalidates existing Silver hashes.
EUROSTREAM_PII_SALT=change-me-in-production
EUROSTREAM_ERASURE_SLA_SECONDS=60
EUROSTREAM_CONSENT_DEFAULT=false

# --- Fraud scoring thresholds --------------------------------------------
EUROSTREAM_FRAUD_VELOCITY_THRESHOLD=5
EUROSTREAM_FRAUD_WINDOW_SECONDS=300
EUROSTREAM_FRAUD_AMOUNT_ZSCORE=3.0
