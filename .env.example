# EuroStream configuration — copy to `.env` and edit.
#
# Every value below is optional: the platform runs end to end on SQLite +
# DuckDB with no configuration at all. `.env` is gitignored; never commit it.
# Names are read with the `EUROSTREAM_` prefix except where noted.

# ---------------------------------------------------------------- event bus
# sqlite (default, durable local WAL log) | kafka (hosted)
EUROSTREAM_EVENT_BUS_BACKEND=sqlite
# Aiven/Confluent style URI or bare host:port — credentials in the URI are stripped
EUROSTREAM_KAFKA_BOOTSTRAP_SERVERS=
EUROSTREAM_KAFKA_USERNAME=
EUROSTREAM_KAFKA_PASSWORD=
EUROSTREAM_KAFKA_SECURITY_PROTOCOL=SASL_SSL
EUROSTREAM_KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# ------------------------------------------------------------------ storage
# Root for the warehouse, lake, and logs (defaults to <repo>/data)
# EUROSTREAM_DATA_DIR=./data
# EUROSTREAM_WAREHOUSE_PATH=./data/eurocart.duckdb
# EUROSTREAM_LAKE_ROOT=./data/lake

# ---------------------------------------------------------------- governance
# Salt for Silver PII hashing. The built-in default is public knowledge —
# inject a per-environment secret before processing anything real.
EUROSTREAM_PII_SALT=change-me
# When set, every mutating endpoint (/erasure-requests, /erase, /produce,
# /stream, /transform, /quality-gate, /sync-turso) requires
# `Authorization: Bearer <token>`. Unset keeps the demo API open.
# EUROSTREAM_API_TOKEN=
# Comma-separated browser origins allowed by CORS (default "*")
# EUROSTREAM_CORS_ORIGINS=

# Documented end-to-end erasure target in seconds (default 60)
# EUROSTREAM_ERASURE_SLA_SECONDS=60

# --------------------------------------------------------------- fraud rules
# EUROSTREAM_FRAUD_VELOCITY_THRESHOLD=5
# EUROSTREAM_FRAUD_WINDOW_SECONDS=300
# EUROSTREAM_FRAUD_AMOUNT_ZSCORE=3.0

# ---------------------------------------------------------- fraud worker
# Score payments in a background thread so alerts reach the warehouse and the
# SSE feed without a manual POST /stream. The endpoint shares the worker's
# consumer group (EUROSTREAM_FRAUD_CONSUMER_GROUP), so nothing scores twice.
# EUROSTREAM_FRAUD_WORKER_ENABLED=true
# EUROSTREAM_FRAUD_CONSUMER_GROUP=api-fraud-stream

# ----------------------------------------------------------------- logging
# text (default, one human-readable line) | json (one object per line, ready
# for a drain). JSON lines carry the request id that also comes back as
# X-Request-ID; secret-looking keys are redacted before serialisation.
# EUROSTREAM_LOG_LEVEL=INFO
# EUROSTREAM_LOG_FORMAT=json

# ------------------------------------------------- optional hosted services
# Turso / libSQL (also accepted without the EUROSTREAM_ prefix)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Hugging Face: lake publication. HF_TOKEN is read by huggingface-hub itself.
# EUROSTREAM_HF_REPO=swadhinbiswas/eustream
# HF_TOKEN=
